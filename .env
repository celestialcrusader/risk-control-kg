# RCKG Platform Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_USER=rckg
POSTGRES_PASSWORD=rckg_secret_password
POSTGRES_DB=rckg_db
POSTGRES_PORT=5432

# ============================================
# Memgraph Configuration
# ============================================
MEMGRAPH_PORT=7687
MEMGRAPH_WEB_PORT=7688
MEMGRAPH_USERNAME=rckg
MEMGRAPH_PASSWORD=rckg_secret_password

# ============================================
# Qdrant Configuration
# ============================================
QDRANT_PORT=6333
QDRANT_HTTP_PORT=6333

# ============================================
# MinIO Configuration
# ============================================
MINIO_ROOT_USER=rckg_admin
MINIO_ROOT_PASSWORD=rckg_secret_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============================================
# Redis Configuration
# ============================================
REDIS_PORT=6379
REDIS_PASSWORD=rckg_secret_password

# ============================================
# Temporal Configuration
# ============================================
TEMPORAL_PORT=7233
TEMPORAL_WEB_PORT=8233

# ============================================
# Langfuse Configuration
# ============================================
LANGFUSE_PORT=3000
LANGFUSE_SECRET_KEY=rckg_secret_key
LANGFUSE_PUBLIC_KEY=rckg_public_key

# ============================================
# Kafka Configuration
# ============================================
KAFKA_PORT=9092
ZOOKEEPER_PORT=2181

# ============================================
# Application Configuration
# ============================================
RCKG_ENV=development
RCKG_LOG_LEVEL=DEBUG
