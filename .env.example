# RCKG Platform Environment Configuration
# Copy this file to .env and customize for your environment
#
# IMPORTANT: For production deployments, generate secure random values for
# all *_PASSWORD, *_SECRET_KEY, *_SECRET, and *_SALT variables.
# Example: openssl rand -base64 32

# ==============================================================================
# 1. AI INFERENCE MODE SELECTION
# ==============================================================================
# MODE A: External Cloud API (OpenAI / Groq / OpenRouter) - Requires 0 GB VRAM
# ------------------------------------------------------------------------------
# Set your API key and point to any OpenAI-compatible provider:
# OPENAI_API_KEY=sk-proj-your-openai-api-key
# MODEL_EXTRACTION_ENDPOINT=https://api.openai.com/v1
# MODEL_EXTRACTION_NAME=gpt-4o-mini
# MODEL_JUDGE_ENDPOINT=https://api.openai.com/v1
# MODEL_JUDGE_NAME=gpt-4o-mini
# LLM_PROVIDER=openai

# MODE B: On-Prem Air-Gapped GPU Inference (Local vLLM) - Requires NVIDIA GPU
# ------------------------------------------------------------------------------
# When running with GPU overlay: `docker compose -f docker-compose.yml -f docker-compose.ai.yml up -d`
MODEL_EXTRACTION_ENDPOINT=http://localhost:8000/v1
MODEL_EXTRACTION_NAME=nvidia/Qwen3.6-35B-A3B-NVFP4
MODEL_JUDGE_ENDPOINT=http://localhost:8000/v1
MODEL_JUDGE_NAME=nvidia/Qwen3.6-35B-A3B-NVFP4
MODEL_PARSER_ENDPOINT=http://localhost:8002/v1
MODEL_PARSER_NAME=PaddlePaddle/PaddleOCR-VL-1.6
MODEL_EMBEDDING_NAME=Qwen/Qwen3-Embedding-8B
MODEL_EMBEDDING_DIM=4096
MODEL_RERANKER_NAME=Qwen/Qwen3-Reranker-8B
MODEL_NLI_NAME=answerdotai/ModernBERT-large-NLI
LLM_PROVIDER=vllm

# ==============================================================================
# 2. Infrastructure Data Stores (PostgreSQL, Memgraph, Redis, MinIO, Qdrant)
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_USER=rckg
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_SECURE_RANDOM
POSTGRES_DB=rckg_db
POSTGRES_PORT=5432

# Memgraph Configuration (Hot Graph DB)
MEMGRAPH_PORT=7687
MEMGRAPH_WEB_PORT=7688
MEMGRAPH_USERNAME=rckg
MEMGRAPH_PASSWORD=CHANGE_ME_GENERATE_SECURE_RANDOM

# Qdrant Configuration (Vector DB)
QDRANT_PORT=6333
QDRANT_HTTP_PORT=6333

# MinIO Configuration (Object Storage)
MINIO_ROOT_USER=rckg_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_GENERATE_SECURE_RANDOM
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Redis Configuration (Cache Layer)
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_GENERATE_SECURE_RANDOM

# Temporal Configuration (Workflow Engine)
TEMPORAL_PORT=7233
TEMPORAL_WEB_PORT=8233

# Langfuse Configuration (Observability)
LANGFUSE_PORT=3000
LANGFUSE_SECRET_KEY=CHANGE_ME_GENERATE_SECURE_RANDOM
LANGFUSE_PUBLIC_KEY=CHANGE_ME_GENERATE_SECURE_RANDOM

# Kafka & Zookeeper Configuration
KAFKA_PORT=9092
ZOOKEEPER_PORT=2181

# Application Configuration
RCKG_ENV=development
RCKG_LOG_LEVEL=DEBUG
