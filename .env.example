# RCKG Platform Environment Configuration
# Copy this file to .env and customize for your environment
#
# IMPORTANT: For production deployments, generate secure random values for
# all *_PASSWORD, *_SECRET_KEY, *_SECRET, and *_SALT variables.
# Example: openssl rand -base64 32

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_USER=rckg
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_SECURE_RANDOM
POSTGRES_DB=rckg_db
POSTGRES_PORT=5432

# ============================================
# Memgraph Configuration
# ============================================
MEMGRAPH_PORT=7687
MEMGRAPH_WEB_PORT=7688
MEMGRAPH_USERNAME=rckg
MEMGRAPH_PASSWORD=CHANGE_ME_GENERATE_SECURE_RANDOM

# ============================================
# Qdrant Configuration
# ============================================
QDRANT_PORT=6333
QDRANT_HTTP_PORT=6333

# ============================================
# MinIO Configuration
# ============================================
MINIO_ROOT_USER=rckg_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_GENERATE_SECURE_RANDOM
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============================================
# Redis Configuration
# ============================================
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_GENERATE_SECURE_RANDOM

# ============================================
# Temporal Configuration
# ============================================
TEMPORAL_PORT=7233
TEMPORAL_WEB_PORT=8233

# ============================================
# Langfuse Configuration
# ============================================
LANGFUSE_PORT=3000
LANGFUSE_SECRET_KEY=CHANGE_ME_GENERATE_SECURE_RANDOM
LANGFUSE_PUBLIC_KEY=CHANGE_ME_GENERATE_SECURE_RANDOM

# ============================================
# Kafka Configuration
# ============================================
KAFKA_PORT=9092
ZOOKEEPER_PORT=2181
MODEL_PARSER_NAME=PaddlePaddle/PaddleOCR-VL-1.6

# ============================================
# Application Configuration
# ============================================
RCKG_ENV=development
RCKG_LOG_LEVEL=DEBUG
